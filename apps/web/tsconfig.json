{
  "extends": "../../packages/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@jobbank/shared": ["../../packages/shared/src/index.ts"],
      "@jobbank/shared/*": ["../../packages/shared/src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "*.mjs",
    "*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-build/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
